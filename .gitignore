# IDE files
.idea/
*.iml
.gradle/
.vscode/

# xcresulttool regenerates this cache on every read of a bundle; the bundle is
# fully readable without it (verified: 30/30 measurements recovered).
benchmark-data/**/*.xcresult/database.sqlite3

# Python bytecode from scripts/
__pycache__/
*.pyc

# Local assistant notes, not part of the project
CLAUDE.md

# Build artefacts from the app-size extraction (archives, IPAs); large
# binaries that also embed provisioning profiles.
build/
